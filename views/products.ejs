<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Productos | Parfum</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Parfum</a>
      <a class="btn btn-outline-dark" href="/products">Productos</a>
    </div>
  </nav>

  <main class="container pb-4">
    <h1 class="h3 mb-3">Catálogo de productos</h1>

    <form method="get" action="/products" class="row g-3 mb-4">
      <div class="col-md-3">
        <label class="form-label" for="minPrice">Precio mínimo</label>
        <input class="form-control" id="minPrice" name="minPrice" type="number" min="0" step="0.01" value="<%= filters.minPrice %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="maxPrice">Precio máximo</label>
        <input class="form-control" id="maxPrice" name="maxPrice" type="number" min="0" step="0.01" value="<%= filters.maxPrice %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="brand">Marca</label>
        <select class="form-select" id="brand" name="brand">
          <option value="">Todas</option>
          <% brands.forEach((brand) => { %>
            <option value="<%= brand %>" <%= filters.brand === brand ? 'selected' : '' %>><%= brand %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="group">Grupo</label>
        <select class="form-select" id="group" name="group">
          <option value="">Todos</option>
          <% groups.forEach((groupName) => { %>
            <option value="<%= groupName %>" <%= filters.group === groupName ? 'selected' : '' %>><%= groupName %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Filtrar</button>
        <a class="btn btn-outline-secondary" href="/products">Limpiar</a>
      </div>
    </form>

    <div class="row g-3">
      <% products.forEach((product) => { %>
        <div class="col-md-4">
          <article class="card h-100">
            <div class="card-body">
              <h2 class="h5"><%= product.name %></h2>
              <p class="mb-1"><strong>Marca:</strong> <%= product.brand %></p>
              <p class="mb-1"><strong>Grupo:</strong> <%= product.group_name %></p>
              <p class="mb-3"><strong>Precio:</strong> S/ <%= product.price.toFixed(2) %></p>
              <form method="post" action="/checkout/whatsapp" class="d-flex gap-2">
                <input type="hidden" name="productId" value="<%= product.id %>" />
                <input type="number" class="form-control" name="quantity" value="1" min="1" max="20" />
                <button class="btn btn-success" type="submit">Pagar por WhatsApp</button>
              </form>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
