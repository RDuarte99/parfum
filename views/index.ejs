<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Parfum | Cosmética y Perfumería</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Parfum</a>
      <a class="btn btn-outline-dark" href="/products">Ver productos</a>
    </div>
  </nav>

  <main class="container">
    <section id="carouselParfum" class="carousel slide mb-5" data-bs-ride="carousel">
      <div class="carousel-indicators">
        <% carouselImages.forEach((_, index) => { %>
          <button type="button" data-bs-target="#carouselParfum" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>" aria-label="Slide <%= index + 1 %>"></button>
        <% }) %>
      </div>
      <div class="carousel-inner rounded">
        <% carouselImages.forEach((image, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
            <img src="<%= image %>" class="d-block w-100" alt="Imagen promocional <%= index + 1 %>" style="height: 420px; object-fit: cover;" />
          </div>
        <% }) %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselParfum" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselParfum" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
      </button>
    </section>

    <section>
      <h1 class="h3 mb-3">Destacados</h1>
      <div class="row g-3">
        <% featuredProducts.forEach((product) => { %>
          <div class="col-md-4">
            <article class="card h-100">
              <div class="card-body">
                <h2 class="h5"><%= product.name %></h2>
                <p class="mb-1"><strong>Marca:</strong> <%= product.brand %></p>
                <p class="mb-1"><strong>Grupo:</strong> <%= product.group_name %></p>
                <p class="mb-3"><strong>Precio:</strong> S/ <%= product.price.toFixed(2) %></p>
                <form method="post" action="/checkout/whatsapp" class="d-flex gap-2">
                  <input type="hidden" name="productId" value="<%= product.id %>" />
                  <input type="number" class="form-control" name="quantity" value="1" min="1" max="20" />
                  <button class="btn btn-success" type="submit">Pagar por WhatsApp</button>
                </form>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
